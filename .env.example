# Modo de datos. "demo" (por defecto) no necesita nada más: usa Zustand + localStorage.
VITE_DATA_MODE=demo

# Solo para la fase 2 (nube). La clave PUBLICABLE es segura en el navegador únicamente con RLS activo.
# NUNCA pongas aquí service_role, secret key ni credenciales institucionales.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
