# Copia este archivo a .env.local (nunca se sube al repositorio).

# Frontend (Settings > API Keys en tu proyecto de Supabase). La anon/publishable key es segura en el
# navegador porque todas las tablas tienen RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Solo scripts locales (npm run seed:users). NUNCA con prefijo VITE_ ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseñas de las cuentas de prueba que crea el seed (las eliges tú).
SEED_PASSWORD_ANA=
SEED_PASSWORD_VALE=
SEED_PASSWORD_PAULO=
SEED_PASSWORD_FILLER=

# Asistente IA (solo servidor: Vercel > Settings > Environment Variables). NUNCA con prefijo VITE_.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-haiku-5-5)
ANTHROPIC_MODEL=
